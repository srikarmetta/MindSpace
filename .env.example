# LiveKit Server Configuration
# For production LiveKit Cloud or self-hosted deployment:
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Frontend Client URL (prefixed with VITE_ for Vite bundling)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# AI Model Provider Credentials (used by agent/agent.py)
OPENAI_API_KEY=your_openai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# MindSpace Voice Mode ('livekit' | 'mock')
# Defaults to 'mock' if LiveKit credentials are not configured.
VITE_VOICE_MODE=mock
